    "@modelcontextprotocol/sdk": "^1.29.0",
    "adm-zip": "^0.6.0",
    "ai": "^7.0.30",
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "katex": "^0.16.11",
    "ollama-ai-provider-v2": "^4.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.4.3"
