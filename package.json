    "test:core-lite3.6:p2": "node --test tests/core/coreLiteBoundary.test.js tests/conversation/legacyHistory.test.js tests/conversation/ConversationStore.test.js tests/conversation/ConversationManager.test.js tests/regression/runContinuationContract.test.js tests/contracts/ipcContract.test.js tests/settings/modelSettings.test.js tests/settings/validateSettings.test.js tests/settings/toolAndContextSettings.test.js tests/stability/truthConsistencyP0.test.js",
    "test:core-lite4.1": "node --test tests/agent/finalResponseStream.test.js tests/regression/finalResponseStreamingContract.test.js tests/regression/responseActivityFlowContract.test.js tests/regression/responseRenderingRecovery.test.js tests/contracts/ipcContract.test.js",
    "test:core-lite4.2": "node --test tests/agent/runCancellation.test.js tests/agent/runStateMachine.test.js tests/agent/activeRunText.test.js tests/conversation/cancellationRecovery.test.js tests/tools/toolApprovalController.test.js tests/regression/cancellationConsistencyContract.test.js tests/regression/toolFoundation15Contract.test.js",
    "test:core-lite4.3": "node --test tests/agent/providerRetryPolicy.test.js tests/tools/toolRetryClassification.test.js tests/tools/toolRetry.test.js tests/skills/skillNotification.test.js tests/regression/retryConsistencyContract.test.js tests/runtime/providerCircuitBreaker.test.js tests/agent/runCancellation.test.js",
    "test:core-lite4.4": "node --test tests/agent/checkpointRecoveryPolicy.test.js tests/conversation/interruptedRecovery.test.js tests/conversation/runtimeRecoveryHistory.test.js tests/regression/checkpointRecoveryConsistencyContract.test.js tests/tools/runtimeCheckpointRecovery.test.js tests/tools/runtimeRecoveryManager.test.js tests/regression/runContinuationContract.test.js",
    "test:core-lite4.5": "node --test tests/agent/runTerminalPresentation.test.js tests/conversation/runTerminalPersistence.test.js tests/conversation/cancellationRecovery.test.js tests/conversation/interruptedRecovery.test.js tests/conversation/runtimeRecoveryHistory.test.js tests/ui/runTerminalUserView.test.js tests/regression/terminalStateConsistencyContract.test.js tests/stability/truthConsistencyP0.test.js",
    "test:core-lite4.6": "node --test tests/agent/runLifecycleCoordinator.test.js tests/agent/runCancellation.test.js tests/agent/statusBroadcast.test.js tests/runtime/asyncPersistenceQueue.test.js tests/tools/subprocessSupervisor.test.js tests/regression/runLifecycleRaceContract.test.js tests/regression/toolRuntimeStateMachineContract.test.js tests/regression/responseLifecycleContract.test.js",
    "test:core-lite4.7": "node --test tests/stress/runtimeFaultInjection.test.js tests/regression/runtimeStressContract.test.js tests/agent/runLifecycleCoordinator.test.js tests/agent/statusBroadcast.test.js tests/runtime/asyncPersistenceQueue.test.js tests/tools/subprocessSupervisor.test.js tests/regression/responseLifecycleContract.test.js",
    "test:stress:core-lite4.7": "node tests/performance/core-lite-lifecycle-soak.mjs --seconds=3 --iterations=1500 --subprocess-every=250",
    "test:soak:core-lite4.7": "node tests/performance/core-lite-lifecycle-soak.mjs --seconds=600 --iterations=200000 --subprocess-every=500",
    "test:core-lite4.8": "node --test tests/agent/e2eLongStreamDriver.test.js tests/regression/finalResponseLengthContract.test.js tests/regression/electronReleaseCandidateContract.test.js tests/release/releaseCandidateSummary.test.js tests/regression/runtimeStressContract.test.js tests/regression/runLifecycleRaceContract.test.js tests/regression/responseLifecycleContract.test.js tests/regression/responseWindowOwnershipContract.test.js",
    "test:e2e:electron-rc": "node tests/e2e/electron-release-candidate.cjs",
    "test:stress:core-lite4.8": "node tests/performance/core-lite-lifecycle-soak.mjs --seconds=5 --iterations=2500 --subprocess-every=250 --report=test-results/core-lite-4.8/lifecycle-soak.json",
    "test:soak:core-lite4.8": "node tests/performance/core-lite-lifecycle-soak.mjs --seconds=1800 --iterations=500000 --subprocess-every=500 --report=test-results/core-lite-4.8/lifecycle-soak.json",
    "report:core-lite4.8": "node scripts/create-release-candidate-summary.mjs"
  },
