{
  "name": "my-ai-ui",
  "main": "electron/main.js",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint src electron",
    "preview": "vite preview",
    "electron": "electron .",
    "test": "node --test --test-reporter=spec",
    "test:p0-continuity": "node --test tests/agent/runStopReasons.test.js tests/agent/finalization.test.js tests/tools/toolConcurrencyGuard.test.js tests/tools/workspaceTools.test.js tests/stability/truthConsistencyP0.test.js",
    "test:watch": "node --test --watch --test-reporter=spec",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec",
    "check": "npm run verify:core-lite-tree && npm run lint && npm run test && npm run build",
    "test:electron": "electron tests/electron/preload-smoke.cjs",
    "check:full": "npm run check && npm run test:stress:core-lite4.8 && npm run test:e2e:runtime-crash && npm run test:e2e:runtime-write-crash && npm run test:benchmark && npm run test:electron && npm run test:e2e:electron-runtime-crash && npm run test:e2e:electron-rc && npm run test:e2e && npm run report:core-lite4.8",
    "test:electron:ci": "electron --no-sandbox tests/electron/preload-smoke.cjs",
    "test:e2e": "node tests/e2e/conversation-flow.cjs && node tests/e2e/tool-approval-write-flow.cjs",
    "test:e2e:runtime-crash": "node tests/e2e/tool-runtime-crash-recovery.mjs",
    "test:e2e:runtime-write-crash": "node tests/e2e/tool-runtime-write-crash-matrix.mjs",
    "test:benchmark": "node tests/performance/tool-runtime-benchmark.mjs",
    "test:soak": "node tests/performance/tool-runtime-soak.mjs",
    "test:e2e:electron-runtime-crash": "node tests/e2e/electron-runtime-crash-recovery.cjs",
    "test:e2e:tool-security": "node tests/e2e/tool-approval-write-flow.cjs",
    "test:stability-p0-truth": "node --test tests/stability/truthConsistencyP0.test.js tests/agent/finalization.test.js tests/regression/responseActivityFlowContract.test.js",
    "verify:core-lite-tree": "node scripts/verify-core-lite-tree.mjs",
    "archive:source": "node scripts/create-source-archive.mjs",
